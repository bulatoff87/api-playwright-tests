{
  "name": "api-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "API tests for Swagger Petstore using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:pet": "playwright test --grep @pet",
    "test:store": "playwright test --grep @store",
    "test:user": "playwright test --grep @user",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
